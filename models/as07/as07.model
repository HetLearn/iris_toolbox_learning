% Small New Keynesian model of An and Schorfheide (2007), "Bayesian Analysis of DSGE
% Models", Econometric Reviews 26(2-4), as estimated on US data 1983Q1-2002Q4 by
% Herbst and Schorfheide (2016), "Bayesian Estimation of DSGE Models", Princeton UP,
% Ch. 4.1-4.2.
%
% The equations are those of the book's replication code, written equation by
% equation from estimation/hs2016/Mfiles/model_solution.m (gensys matrices GAM0,
% GAM1, PSI; rows eq_1-eq_6, rows eq_7-eq_8 define the expectational errors), and
% the measurement equations and measurement errors of Mfiles/sysmat.m.
%
% Linear. Transition variables are deviations from the steady state (0), in the
% units of the book's code, which are the package units (README.md, "Units"):
%   y     output, percent: 100 x log of output over the technology level A_t,
%         in deviation from its steady state
%   pinf  inflation, percent per quarter (q/q, not annualised)
%   r     nominal policy rate, percent per quarter
%   g     government spending (demand) shock process, percent
%   z     technology growth shock process, percent per quarter
% The code's measurement equations multiply pi and R by 4 and y by 1
% (INFL = piA + 4*pi_t), so its variables are already in percent: the model
% needs no rescaling, and every impulse response equals the code's.
% Observables in the book's units: dy in % per quarter, pinfobs and robs in
% % a year. Load with Model.fromFile('as07.model', 'linear', true).

!transition_variables

    "Output, % deviation from the technology trend A_t" y
    "Inflation, % q/q" pinf
    "Nominal policy rate, % per quarter" r
    "Government spending (demand) shock process" g
    "Technology growth shock process, % per quarter" z

!transition_shocks

    "Technology growth innovation (book: z_sh, sigma_z)" eps_z
    "Government spending innovation (book: g_sh, sigma_g)" eps_g
    "Monetary policy shock, i.i.d. (book: R_sh, sigma_R)" eps_r

!measurement_shocks

    "Measurement error, output growth (sysmat.m, 20% of the us.txt std)" me_dy
    "Measurement error, inflation (sysmat.m, 20% of the us.txt std)" me_pinfobs
    "Measurement error, federal funds rate (sysmat.m, 20% of the us.txt std)" me_robs

!parameters

    "Inverse intertemporal elasticity of substitution" tau
    "Slope of the Phillips curve" kappa
    "Policy reaction to inflation" psi1
    "Policy reaction to the output gap" psi2
    "Steady-state real interest rate, % a year" rA
    "Steady-state inflation, % a year" piA
    "Steady-state growth rate of technology, % per quarter" gammaQ
    "Interest-rate smoothing" rho_r
    "Persistence of the government spending shock" rho_g
    "Persistence of the technology growth shock" rho_z

!substitutions

    % discount factor, as in model_solution.m: bet = 1/(1+rA/400)
    beta = 1/(1 + rA/400);

!transition_equations

    "Consumption Euler equation (model_solution.m eq_1)"
    y = y{+1} - (1/tau)*(r - pinf{+1} - rho_z*z) + (1 - rho_g)*g;

    "New Keynesian Phillips curve (model_solution.m eq_2)"
    pinf = $beta$*pinf{+1} + kappa*(y - g);

    "Monetary policy rule, Taylor rule with smoothing (AS07)"
    r = rho_r*r{-1} + (1 - rho_r)*(psi1*pinf + psi2*(y - g)) + eps_r;

    "Government spending shock, AR(1) (model_solution.m eq_5)"
    g = rho_g*g{-1} + eps_g;

    "Technology growth shock, AR(1) (model_solution.m eq_6)"
    z = rho_z*z{-1} + eps_z;

!measurement_variables

    "Output growth, per capita, % q/q" dy
    "CPI inflation, % a year" pinfobs
    "Federal funds rate, % a year (missing at the ELB)" robs

!measurement_equations

    "Output growth: trend growth plus the change in y plus the technology shock (sysmat.m)"
    dy = gammaQ + y - y{-1} + z + me_dy;

    "Inflation, annualised: piA plus 4 x model inflation (sysmat.m)"
    pinfobs = piA + 4*pinf + me_pinfobs;

    "Federal funds rate, annualised: piA + rA + 4 gammaQ plus 4 x model rate (sysmat.m)"
    robs = piA + rA + 4*gammaQ + 4*r + me_robs;
