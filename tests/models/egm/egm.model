% egm.model: scalar economy y_t = mu + b*E y_{t+1} + u_t with an AR(1) disturbance (tests/test_anchor.m).
% Level-k thinking on a constant level-0 forecast a with information up to t-1 (Evans, Gibbs and
% McGough 2025, DESIGN_br_extensions mechanism 1): level k forecasts E_{t-1} y_{t+1} = k_k + c_k*u_{t-1},
% k_k = mu*(1 + b + ... + b^(k-1)) + b^k*a and c_k = rho^2*(1 + b*rho + ... + (b*rho)^(k-1)).

!transition_variables
    "Output" y
    "Disturbance" u

!transition_shocks
    "Disturbance shock" e

!parameters
    "Constant" mu
    "Weight on the expectation" b
    "Persistence of the disturbance" rho

!transition_equations
    "Scalar economy" y = mu + b*y{+1} + u;
    "Disturbance" u = rho*u{-1} + e;
